{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strata",
  "version": "0.10.1",
  "identifier": "app.strata.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Strata",
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#0B0C0E",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Strata",
    "shortDescription": "Strata game launcher",
    "longDescription": "Strata is a launcher frontend for the open-source KytyPS5 engine.",
    "copyright": "GPL-2.0. Engine: KytyPS5 contributors.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
